// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Shop where the app is installed; root of all app data. Deleting the shop
// (e.g. on the shop/redact webhook) cascades to bins, stock and movements.
// The Shopify Location selected here is the warehouse that bin management and
// all picking operations run against.
model Shop {
  shop              String           @id // myshopify domain, e.g. store.myshopify.com
  locationId        String? // gid://shopify/Location/...
  locationName      String?
  // Full inventory sync (Shopify bulk operation) for the selected location.
  syncOperationId   String? // gid://shopify/BulkOperation/...
  syncStatus        String? // RUNNING | COMPLETED | FAILED
  syncedAt          DateTime?
  // Picking: comma-separated "orders per round" options; the first is the default.
  pickingBatchSizes String           @default("1,4,8,16,32")
  // Packing: PACK (tag only) | PACK_AND_FULFILL (also fulfill in Shopify).
  packingMode       String           @default("PACK")
  // Shop time zone (IANA, from Shopify), for "today" and per-day stats.
  timezone          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  bins              Bin[]
  binStock          BinStock[]
  movements         StockMovement[]
  inventory         InventoryLevel[]
  pickingRounds     PickingRound[]
  pickingOrders     PickingOrder[]
  pickingLines      PickingLine[]
  pickingTasks      PickingTask[]
}

// Physical storage location inside a Shopify location (aisle/rack/shelf).
model Bin {
  id           Int             @id @default(autoincrement())
  shop         String
  shopRef      Shop            @relation(fields: [shop], references: [shop], onDelete: Cascade)
  locationId   String // Shopify location this bin belongs to
  code         String // ex.: "A-01-03"
  description  String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  stock        BinStock[]
  movements    StockMovement[]
  pickingTasks PickingTask[]

  @@unique([shop, locationId, code])
  @@index([shop, locationId])
}

// Stock of a product (inventory item) in a bin. A product can be in several
// bins; the sum per Shopify location should match Shopify's on-hand stock.
model BinStock {
  id              Int      @id @default(autoincrement())
  shop            String
  shopRef         Shop     @relation(fields: [shop], references: [shop], onDelete: Cascade)
  binId           Int
  bin             Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  inventoryItemId String // gid://shopify/InventoryItem/... (Shopify's stock unit)
  variantId       String? // gid://shopify/ProductVariant/... (cache)
  sku             String? // cached for search/display
  quantity        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([binId, inventoryItemId])
  @@index([shop, inventoryItemId])
  @@index([shop, sku])
}

// Stock movement history per bin (receipts, picks, transfers, adjustments,
// counts). Used for auditing and reconciling with Shopify.
model StockMovement {
  id              Int      @id @default(autoincrement())
  shop            String
  shopRef         Shop     @relation(fields: [shop], references: [shop], onDelete: Cascade)
  binId           Int
  bin             Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  inventoryItemId String
  delta           Int // positive = in, negative = out
  reason          String // RECEIVE | PICK | TRANSFER_IN | TRANSFER_OUT | ADJUST | COUNT
  reference       String? // e.g. order or transfer id
  userId          String? // Shopify user who made the movement
  // Set on operations that also change Shopify (e.g. receiving): the same key is
  // sent to Shopify as the idempotency key, so retries apply only once.
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())

  @@index([shop, inventoryItemId, createdAt])
  @@index([binId, createdAt])
}

// Local copy of Shopify's on-hand stock per inventory item at the selected
// location, kept in sync by a bulk operation plus the inventory_levels/update
// webhook, with the app's own totals next to it:
// - binQuantity: units in this location's bins (sum of BinStock.quantity);
// - boxQuantity: units picked into boxes whose orders aren't fulfilled yet
//   (still on hand for Shopify);
// - accountedQuantity: binQuantity + boxQuantity, stored so the list and the
//   mismatch filter (onHand != accountedQuantity) are a single indexed query.
// Change these totals only through adjustLevelTotals / recomputeLevelTotals
// (app/models/inventory.server.ts), in the same transaction as the rows they sum.
model InventoryLevel {
  id                Int      @id @default(autoincrement())
  shop              String
  shopRef           Shop     @relation(fields: [shop], references: [shop], onDelete: Cascade)
  locationId        String
  inventoryItemId   String
  variantId         String?
  productId         String?
  productTitle      String
  variantTitle      String?
  sku               String?
  barcode           String?
  imageUrl          String?
  onHand            Int      @default(0)
  binQuantity       Int      @default(0)
  boxQuantity       Int      @default(0)
  accountedQuantity Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([shop, locationId, inventoryItemId])
  @@index([shop, locationId, productTitle, id])
}

// A picking round: a batch of orders picked together, built through the picking
// wizard. Step 1 creates it (IN_PROGRESS) with the order filters; later steps add
// orders and boxes.
model PickingRound {
  id              Int            @id @default(autoincrement())
  shop            String
  shopRef         Shop           @relation(fields: [shop], references: [shop], onDelete: Cascade)
  locationId      String // Shopify location picked from
  status          String         @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  financialStatus String // Shopify order financial status filter, e.g. "paid"
  orderTag        String? // optional Shopify order tag filter
  orderLimit      Int // how many orders the round picks
  createdBy       String? // Shopify user who started the round
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orders          PickingOrder[]
  lines           PickingLine[]
  tasks           PickingTask[]
  // Step 3: set once the picking plan (lines and tasks) is built.
  plannedAt       DateTime?
  completedAt     DateTime?

  @@index([shop, status])
}

// An order reserved by a picking round, and the picking box it goes into.
// Concurrency is enforced by unique keys that are only set while held:
// - reservationKey ("<shop>|<orderId>") while the round holds the order, so two
//   rounds can't reserve the same order. Held until Shopify reports the order
//   fulfilled or cancelled; deleting the row (cancelling the round) releases it.
// - boxKey ("<shop>|<boxCode>") while the box is in use, so a box can't serve two
//   orders. Cleared when Shopify reports the order fulfilled or cancelled.
model PickingOrder {
  id                  Int           @id @default(autoincrement())
  shop                String
  shopRef             Shop          @relation(fields: [shop], references: [shop], onDelete: Cascade)
  roundId             Int
  round               PickingRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  orderId             String // gid://shopify/Order/...
  orderName           String // e.g. #1001
  orderCreatedAt      DateTime
  itemCount           Int // units in the order
  position            Int // order within the round (oldest first)
  reservationKey      String?       @unique
  boxCode             String?
  boxKey              String?       @unique
  boxAssignedAt       DateTime?
  releasedAt          DateTime? // when fulfillment/cancellation freed the box
  // Cart slot (1..n) in box scan order, fixed when picking starts.
  slot                Int?
  // When the "picked" tag was added in Shopify (fully picked orders only).
  taggedAt            DateTime?
  // Packing (after picking).
  packedAt            DateTime?
  packedBy            String? // Shopify user who packed it
  packedTaggedAt      DateTime? // when the "packed" tag was added in Shopify
  // The packing mode when it was packed: true if it still has to be fulfilled
  // from the app (PACK_AND_FULFILL). Changing the setting later doesn't reopen
  // orders already packed.
  fulfillAfterPacking Boolean       @default(false)
  // Fulfillment from the app (PACK_AND_FULFILL). fulfillingAt is a lock set while
  // the request to Shopify runs, so a double submit can't fulfill twice.
  fulfillingAt        DateTime?
  fulfilledAt         DateTime?
  trackingCompany     String?
  trackingNumber      String?
  lines               PickingLine[]
  createdAt           DateTime      @default(now())

  @@unique([roundId, orderId])
  @@index([shop, orderId])
}

// What an order needs from the location: its open fulfillment order line items,
// one row per inventory item (snapshot taken when picking starts).
model PickingLine {
  id              Int           @id @default(autoincrement())
  shop            String
  shopRef         Shop          @relation(fields: [shop], references: [shop], onDelete: Cascade)
  roundId         Int
  round           PickingRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  pickingOrderId  Int
  pickingOrder    PickingOrder  @relation(fields: [pickingOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  variantId       String?
  productTitle    String
  variantTitle    String?
  sku             String?
  barcode         String?
  imageUrl        String?
  quantity        Int
  packed          Int           @default(0) // units checked into the parcel when packing
  tasks           PickingTask[]

  @@unique([pickingOrderId, inventoryItemId])
  @@index([roundId])
}

// A card of the picking route: units of one line to take from one bin (binId
// null when no bin has stock left). Tasks with the same `step` (one product in
// one bin) are shown together; steps follow the route (bins alphabetically).
model PickingTask {
  id         Int          @id @default(autoincrement())
  shop       String
  shopRef    Shop         @relation(fields: [shop], references: [shop], onDelete: Cascade)
  roundId    Int
  round      PickingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  lineId     Int
  line       PickingLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  step       Int
  binId      Int?
  bin        Bin?         @relation(fields: [binId], references: [id], onDelete: SetNull)
  binCode    String? // snapshot, shown even if the bin is later removed
  quantity   Int
  picked     Int          @default(0)
  short      Int          @default(0) // units skipped as missing
  stockTaken Int          @default(0) // units actually removed from the bin (undo and cancel restore exactly these)

  @@index([roundId, step])
}
